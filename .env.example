# Common UniThesis/TEDF environment template. Copy a specific template instead:
# - .env.development.example for local developer runtime
# - .env.production.example for Docker production

ASPNETCORE_ENVIRONMENT=Production

MSSQL_SA_PASSWORD=CHANGE_ME
MONGODB_DATABASE_NAME=UniThesisLogs

JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_ISSUER=TEDF.API
JWT_AUDIENCE=TEDF.Client
JWT_EXPIRATION_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_IN_DAYS=7

FRONTEND_PUBLIC_ORIGIN=https://tedf.io.vn

FIREBASE_PROJECT_ID=unithesis-38c38
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=./secrets/service-account.json
FIREBASE_STORAGE_BUCKET_NAME=CHANGE_ME_FIREBASE_STORAGE_BUCKET

VITE_API_BASE_URL=/api
VITE_FIREBASE_API_KEY=CHANGE_ME_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=CHANGE_ME_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=unithesis-38c38
VITE_FIREBASE_STORAGE_BUCKET=CHANGE_ME_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=CHANGE_ME_FIREBASE_APP_ID

CACHE_DEFAULT_EXPIRATION_IN_MINUTES=30
CACHE_L1_EXPIRATION_IN_MINUTES=2
CACHE_L2_EXPIRATION_IN_MINUTES=15
CACHE_INVALIDATION_CHANNEL=cache:invalidate

FIREBASE_STORAGE_MAX_FILE_SIZE_BYTES=52428800
FIREBASE_STORAGE_SIGNED_URL_EXPIRATION_MINUTES=60
FIREBASE_STORAGE_MAKE_PUBLIC_BY_DEFAULT=true

MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_FAIL_CLOSED=true

UNITHESIS_RESET_LOADTEST_ON_STARTUP=false

SMTP_SERVER=
SMTP_PORT=0
SMTP_SENDER_NAME=UniThesis System
SMTP_SENDER_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
