<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>616ad968-ba50-4e64-bf06-1cbf4ea1a53c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Endpoints\Commons\**" />
    <Compile Remove="Endpoints\Evaluators\**" />
    <Compile Remove="Endpoints\Mentor\**" />
    <Content Remove="Endpoints\Commons\**" />
    <Content Remove="Endpoints\Evaluators\**" />
    <Content Remove="Endpoints\Mentor\**" />
    <EmbeddedResource Remove="Endpoints\Commons\**" />
    <EmbeddedResource Remove="Endpoints\Evaluators\**" />
    <EmbeddedResource Remove="Endpoints\Mentor\**" />
    <None Remove="Endpoints\Commons\**" />
    <None Remove="Endpoints\Evaluators\**" />
    <None Remove="Endpoints\Mentor\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Configurations\" />
    <Folder Include="Filters\" />
    <Folder Include="Middlewares\" />
    <Folder Include="Models\Requests\" />
    <Folder Include="Models\Responses\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.23">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEDF.Application\TEDF.Application.csproj" />
    <ProjectReference Include="..\TEDF.Infrastructure\TEDF.Infrastructure.csproj" />
    <ProjectReference Include="..\TEDF.Persistence\TEDF.Persistence.csproj" />
  </ItemGroup>

</Project>
