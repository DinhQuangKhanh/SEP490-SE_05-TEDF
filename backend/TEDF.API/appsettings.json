{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "HangfireConnection": ""
  },
  "MongoDbSettings": {
    "ConnectionString": "",
    "DatabaseName": "TEDFLogs"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "TEDF.API",
    "Audience": "TEDF.Client",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "FirestoreMail": {
    "Enabled": true,
    "ProjectId": "",
    "ServiceAccountKeyPath": "",
    "MailCollection": "mail",
    "FrontendBaseUrl": ""
  },
  "FileStorageSettings": {
    "BasePath": "wwwroot/uploads",
    "MaxFileSizeInMB": 50,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".pptx",
      ".zip",
      ".rar",
      ".jpg",
      ".jpeg",
      ".png"
    ]
  },
  "CacheSettings": {
    "Provider": "Hybrid",
    "DefaultExpirationInMinutes": 30,
    "RedisConnectionString": "",
    "L1ExpirationMinutes": 2,
    "L2ExpirationMinutes": 15,
    "InvalidationChannel": "cache:invalidate"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "SimilarityService": {
    "BaseUrl": "http://localhost:8000"
  }
}
